---
import { getCollection } from "astro:content";
import Layout from "../components/Layout.astro";

const publishedEssays = await getCollection("essays", ({ data }) => data.visible);

const newestFirst = (a, b) => b.data.date.valueOf() - a.data.date.valueOf();

/** Group visible essays by year: `Map<year, essays[]>` in reverse-chronological order. */
const essaysByYear = publishedEssays.sort(newestFirst).reduce((groups, essay) => {
    const year = essay.data.date.getFullYear();

    if (!groups.has(year)) {
        groups.set(year, []);
    }
    groups.get(year).push(essay);

    return groups;
}, new Map());

/** "Dec 20" — the year is already shown by the group heading. */
const formatDay = (date) =>
    date.toLocaleDateString("en-US", { month: "short", day: "numeric" });
---

<Layout>
    <div class="container">
        <div>
            <h1 class="title heading">Essays</h1>
            <p class="comment">
                Lorem ipsum dolor sit amet, consectetur adipisicing elit.
                Doloremque itaque fuga cupiditate deleniti explicabo deserunt.
                Mollitia neque laborum repellat commodi?
            </p>
        </div>

        <div class="archive">
            {
                [...essaysByYear].map(([year, essays]) => (
                    <section class="year-group">
                        <h2 class="year">{year}</h2>
                        <ul class="essay-list">
                            {essays.map((essay) => (
                                <li class="essay">
                                    <a class="essay-link" href={`/essays/${essay.id}`}>
                                        <h3 class="title essay-title">{essay.data.title}</h3>
                                        <time
                                            class="essay-date"
                                            datetime={essay.data.date.toISOString()}
                                        >
                                            {formatDay(essay.data.date)}
                                        </time>
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </section>
                ))
            }
        </div>
    </div>
</Layout>

<style>
    .container {
        max-width: 768px;
        padding-block-start: 1rem;
        margin-inline: auto;

        padding-inline: 1rem;
    }

    .heading {
        font-size: 2.5rem;
        font-weight: 800;

        @media (width > 1024px) {
            font-size: 3rem;
        }
    }

    .comment {
        font-size: 1rem;
        line-height: 1.75;

        @media (width > 1024px) {
            font-size: 1.25rem;
        }
    }

    .archive {
        margin-block-start: 2.5rem;
    }

    .year-group + .year-group {
        margin-block-start: 2.5rem;
    }

    /* clear the UA default (40px inset + 1em margins) so rows line up with the year rule */
    .essay-list {
        padding: 0;
        margin: 0;
    }

    .year {
        font-size: 0.875rem;
        font-weight: 700;
        margin: 0;
        padding-block-end: 0.75rem;
        border-block-end: 1px solid #e5e5e5;
    }

    .essay {
        border-block-end: 1px solid #e5e5e5;
    }

    .essay-link {
        display: block;
        padding-block: 1.25rem;
        color: inherit;
        text-decoration: none;
    }

    .essay-link:focus-visible {
        outline: 2px solid #ffa000;
        outline-offset: 4px;
        border-radius: 4px;
    }

    .essay-title {
        font-size: 1.5rem;
        font-weight: 500;
        line-height: 1.3;
        margin: 0;
    }

    .essay-link:hover .essay-title {
        text-decoration: underline;
        text-underline-offset: 0.15em;
    }

    .essay-date {
        display: block;
        margin-block-start: 0.5rem;
        font-size: 1rem;
        color: #71717a;
    }
</style>
