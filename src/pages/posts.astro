---
import moment from "moment";
import Base from "../layouts/base.astro";
import type { Post } from "../types";

const allPosts: Post[] = Object.values(
    import.meta.glob("./essays/*.md", { eager: true }),
);

const allPostsDescending = allPosts.sort(
    (postA, postB) =>
        new Date(postB.frontmatter.date).getTime() -
        new Date(postA.frontmatter.date).getTime(),
);
---

<Base
    title="Ezekiel | Essays"
    url="posts"
    description={"All essays from ezekiel. Ezekiel is a software developer who lives in Lagos. He loves understanding how things works. You will most likely see him nerding out on documentaries, books or playing hard games"}
>
<div class="container">
        <h1 class="heading">Posts by Ezekiel</h1>
        <ul>
            {
                allPostsDescending.map((post) => (
                    <li>
                        <article>
                            <h3>{post.frontmatter.title}</h3>
                            <p class="description">
                                {post.frontmatter.description}
                            </p>
                            <p class="date">
                                {moment(post.frontmatter.date).format(
                                    "Do MMMM YYYY",
                                )}
                            </p>
                            <a href={post.url} aria-label="link to post" />
                        </article>
                    </li>
                ))
            }
        </ul>
    </div>
</Base>

<style>
    h1 {
        margin-block-end: 2rem;
    }
    h3 {
        text-decoration: none;
        font-family: 'Gloria Hallelujah';
    }

    article {
        position: relative;

        &:hover {
            text-decoration: underline;
        }

        & > a {
            position: absolute;
            width: 100%;
            height: 100%;
            inset: 0;
        }

        .date {
            font-size: 0.75rem;
            margin-top: 0.75rem;
        }
    }

    div {
        max-width: 738px;
        margin-inline: auto;
        padding-inline: 2rem;
        margin-top: 2.75rem;
    }

    ul {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 3rem;
    }

    .container {
        margin-block: 1rem;
    }
</style>
