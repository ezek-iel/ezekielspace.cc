---
import Layout from "../components/Layout.astro";
import FallingPills from "../components/FallingPills.astro";
import meta from "../meta.json";
---

<Layout
  title="Ezekiel Akinfenwa — Software Engineer in Lagos"
  description="I build software that works perfectly and runs seamlessly. Go, TypeScript and SvelteKit. Essays on engineering, AI tooling and shipping."
>
    <FallingPills/>
  <main>
    <p class="top">Hello, I'm Ezekiel</p>
    <h1 class="title heading">
      I build software that works <span>perfectly</span> and runs <span
        >seamlessly.</span
      >
    </h1>
    <p class="bottom">
      Currently working on <strong>{meta.currentlyWorkingOn}</strong>.
    </p>
  </main>
</Layout>

<style>
  main {
    position: relative;
    z-index: 1;
    padding-inline: 0.5rem;
    margin-block-start: 5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    
    max-width: 1024px;
    margin-inline: auto;
  }

  .top,
  .bottom {
    text-align: center;
    /* 3rem on desktop, ~1rem on phones */
    font-size: 1.25rem;
    color: #212121;

    strong {
      font-weight: 600;
    }
  }

  .heading {
    /* 8rem on desktop, ~2.1rem on phones */
    font-size: 3.5rem;
    line-height: 0.95;
    letter-spacing: -0.05em;
    text-align: center;
    text-wrap: balance;
    font-weight: 800;

    span {
      font-weight: 400;
    }
  }

  @media (width > 1024px) {
    .heading {
      font-size: 5rem;
    }

    .main {
      padding-block-start: 0;
    }

    .top, .bottom {
      font-size: 1.5rem;
    }
  }
</style>
