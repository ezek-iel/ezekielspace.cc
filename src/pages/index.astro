---
// Scaffolding only — replace with the real design.
import { getCollection } from 'astro:content';

const essays = (await getCollection('essays', ({ data }) => data.visible)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ezekiel</title>
  </head>
  <body>
    <h1>Essays</h1>
    <ul>
      {
        essays.map((essay) => (
          <li>
            <a href={`/essays/${essay.id}/`}>{essay.data.title}</a>
          </li>
        ))
      }
    </ul>
  </body>
</html>
