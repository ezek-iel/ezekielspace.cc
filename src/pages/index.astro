---
import Layout from "../components/Layout.astro";
import meta from "../meta.json";
import { Icon } from "astro-icon/components";
---

<Layout
  title="Ezekiel Akinfenwa — Software Engineer in Lagos"
  description="I build software that works perfectly and runs seamlessly. Go, TypeScript and SvelteKit. Essays on engineering, AI tooling and shipping."
  ogImage=""
>
  <div class="container">
    <div class="top grid">
      <div class="inner">
        <img src="/profile-pic.jpg" alt="Profile Picture" class="profile-pic" />
        <h1 class="title">Hello, I'm Ezekiel.</h1>
      </div>
    </div>
    <div class="content">
      <p>
        Software engineer in Lagos. I build high-performance and reliable
        systems using{" "}
        <a href="https://go.dev" target="_blank">
          Go
        </a>{" "}
        and{" "}
        <a href="https://svelte.dev" target="_blank">
          Svelte
        </a>
        .
      </p>
      <p>
        I believe web software should be fast and resilient.
        <br />
        Instead of relying on heavy frameworks, I use Go for{" "}
        <strong>robust backends</strong> and Svelte for
        <strong>&nbsp;lightweight frontends that don't bloat the browser</strong>.
        This keeps software snappy, highly performant and focused on user
        experience (which matters more than ever).
      </p>
      <p>
        I learn in public. I spend my time reading the source code of Go
        open-source projects to master idiomatic patterns. I share what I find
        through essays, Bluesky and YouTube videos.
      </p>
      <p>
        I am currently open to full-time roles. If you are building something
        where performance and user experience actually matter, let's talk.
      </p>
      <hr />
      <ul class="footer-links">
        <li>
          <a href=`mailto:${meta["socials"]["email"]}`><Icon name="tabler:mail"/>Email</a>
        </li>
        <li>
          <a href={meta["socials"]["bluesky"]} target="_blank">
            <Icon name="tabler:brand-bluesky"/>Bluesky
          </a>
        </li>
        <li>
          <a href={meta["socials"]["github"]} target="_blank">
            <Icon name="tabler:brand-github"/>GitHub
          </a>
        </li>
        <li>
          <a href={meta['socials']['youtube']} target="_blank">
            <Icon name="tabler:brand-youtube"/>YouTube
          </a>
        </li>
        <li>
          <a href={meta["cv-link"]} target="_blank">
            <Icon name="tabler:file-cv"/>CV
          </a>
        </li>
      </ul>
    </div>
  </div>
</Layout>

<style>
  .container {
    padding-block-start: 2rem;
    padding-block-end: 4rem;

    h1 {
      font-weight: 900;
      font-size: 2.5rem;
    }

    
  }
  
  .top {
    padding-inline: 1rem;
    padding-block: 2rem;
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-items: center;

    margin-inline: auto;
    max-width: 768px;
  }

  .profile-pic {
    width: 200px;
    height: 200px;
  }

  .content {
    max-width: 768px;
    margin-inline: auto;

    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 2rem;
    font-size: 1.15rem;
    line-height: 1.95;
    padding-inline: 1.5rem;
  }

  hr {
    color: #9e9e9e;
  }

  .footer-links {
    padding-block: 1rem;
    line-height: 2;

    padding-inline: 0;

    a {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
    }
  }

  @media (width > 1024px) {
    .top.grid {
      padding-block: 3rem;
    }
    
    .inner {
      flex-direction: row;
      max-width: 768px;
      margin-inline: auto;
    }

    h1.title {
      font-size: 3.5rem;
    }

    .profile-pic {
      width: 200px;
      height: 200px;
      border: solid 1px #868686
    }

    .content {
      margin-block: 2rem;
      font-size: 1.25rem;
    }
  }
</style>
