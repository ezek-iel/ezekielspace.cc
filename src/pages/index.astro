---
import Base from "../layouts/base.astro";
import PinnedPosts from "../components/PinnedPosts.astro";
---

<Base
	title={"Ezekiel | Home"}
	description={"Ezekiel is a software developer who lives in Lagos. He loves understanding how things works. You will most likely see him nerding out on documentaries, books or playing hard games"}
>
	<div class="container">
		<div class="profile">
			<img
				src="/profile-pic.png"
				alt="Ezekiel's Profile Picture Image"
				class="profile-picture"
			/>
			<div class="head-info">
				<h1 class="heading">I'm Ezekiel</h1>
				<p class="heading subtitle">
					Software Engineer from Lagos, Nigeria.
				</p>
			</div>
		</div>
		<p class="essay heading">
			I enjoy making software and love understanding how things work. <br
			/> Aside from coding, I enjoy playing games
			<svg
				xmlns="http://www.w3.org/2000/svg"
				width="24"
				height="24"
				viewBox="0 0 24 24"
				><g
					fill="none"
					stroke="#000"
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					><path
						d="M12 5h3.5a5 5 0 0 1 0 10H10l-4.015 4.227a2.3 2.3 0 0 1-3.923-2.035l1.634-8.173A5 5 0 0 1 8.6 5z"
					></path><path
						d="m14 15l4.07 4.284a2.3 2.3 0 0 0 3.925-2.023l-1.6-8.232M8 9v2m-1-1h2m5 0h2"
					></path></g
				></svg
			>, watching documentary <svg
				xmlns="http://www.w3.org/2000/svg"
				width="24"
				height="24"
				viewBox="0 0 24 24"
				><path
					fill="none"
					stroke="#000"
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M4 6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zm4-2v16m8-16v16M4 8h4m-4 8h4m-4-4h16m-4-4h4m-4 8h4"
				></path></svg
			>and listening to Japaneese Jazz
			<svg
				xmlns="http://www.w3.org/2000/svg"
				width="24"
				height="24"
				viewBox="0 0 24 24"
				><path
					fill="none"
					stroke="#000"
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M3 17a3 3 0 1 0 6 0a3 3 0 0 0-6 0m6 0V4h10v6M9 8h10m-1.2 12.817l-2.172 1.138a.392.392 0 0 1-.568-.41l.415-2.411l-1.757-1.707a.389.389 0 0 1 .217-.665l2.428-.352l1.086-2.193a.392.392 0 0 1 .702 0l1.086 2.193l2.428.352a.39.39 0 0 1 .217.665l-1.757 1.707l.414 2.41a.39.39 0 0 1-.567.411z"
				></path></svg
			>
		</p>
		<div class="actions">
			<a href="https://www.github.com/ezek-iel" class="btn heading"
				>Github <svg
					xmlns="http://www.w3.org/2000/svg"
					width="24"
					height="24"
					viewBox="0 0 24 24"
					><path
						fill="none"
						stroke="#fff"
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2c2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2a4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6c-.6.6-.6 1.2-.5 2V21"
					></path></svg
				></a
			>
			<!-- 
			
			<a target="_blank" class="btn heading"
			>Watch Videos <svg
			xmlns="http://www.w3.org/2000/svg"
			width="24"
			height="24"
			viewBox="0 0 24 24"
			><path
						fill="#fff"
						d="M6 4v16a1 1 0 0 0 1.524.852l13-8a1 1 0 0 0 0-1.704l-13-8A1 1 0 0 0 6 4"
						></path></svg
						></a
						>
						-->
			<a href="/posts" class="btn heading"
				>Essays <svg
					xmlns="http://www.w3.org/2000/svg"
					width="24"
					height="24"
					viewBox="0 0 24 24"
					><g
						fill="none"
						stroke="#fff"
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						><path d="m14 6l7 7l-4 4"></path><path
							d="M5.828 18.172a2.83 2.83 0 0 0 4 0L20.414 7.586a2 2 0 0 0 0-2.829l-1.171-1.171a2 2 0 0 0-2.829 0L5.828 14.172a2.83 2.83 0 0 0 0 4M4 20l1.768-1.768"
						></path></g
					></svg
				></a
			>
			<a href="https://bsky.app/profile/ezekielspace.cc" target="_blank" class="btn heading"
				>Bluesky
				<svg
					width="24"
					height="24"
					viewBox="0 0 24 24"
					fill="none"
					xmlns="http://www.w3.org/2000/svg"
				>
					<defs>
						<clipPath id="clip_path_1">
							<rect width="24" height="24"></rect>
						</clipPath>
					</defs>
					<g clip-path="url(#clip_path_1)">
						<path
							d="M0 0L24 0L24 24L0 24L0 0Z"
							transform="scale(1 1)"></path>
						<path
							d="M4.335 1.14424C2.681 -0.0547657 0 -0.982767 0 1.97024C0 2.56024 0.35 6.92324 0.556 7.63124C1.269 10.0942 3.686 10.3812 6 10.0002C1.955 10.6652 1.111 13.2083 3.333 15.4103C4.363 16.4283 5.246 17.0003 6 17.0003C8 17.0003 9.134 14.2313 9.5 13.5003C9.83333 12.8336 10 12.3336 10 12.0003C10 12.3336 10.1667 12.8336 10.5 13.5003C10.866 14.2313 12 17.0003 14 17.0003C14.754 17.0003 15.637 16.4293 16.667 15.4103C18.889 13.2073 18.045 10.6642 14 10.0002C16.314 10.3802 18.73 10.0942 19.444 7.63125C19.65 6.92324 20 2.55924 20 1.97024C20 -0.982766 17.32 -0.054765 15.665 1.14424C13.372 2.80624 10.905 6.19224 10 8.00025C9.095 6.19224 6.628 2.80624 4.335 1.14424"
							fill="none"
							stroke-width="2"
							stroke="#FFFFFF"
							stroke-linecap="round"
							stroke-linejoin="round"
							transform="translate(2 4)"></path>
					</g>
				</svg></a
			>
		</div>
		<p class="essay heading">
			<PinnedPosts />
		</p>
	</div>
</Base>

<style>
	div.actions {
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
		align-items: start;

		@media (width > 594px) {
			align-items: center;
			flex-direction: row;
		}
	}
	div.head-info {
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
	}

	.profile {
		display: flex;
		flex-direction: column;
		align-items: start;
		margin-bottom: 1.75rem;

		@media (width > 738px) {
			flex-direction: row;
			align-items: center;
			gap: 1rem;
		}
	}

	.profile-picture {
		border-radius: 100%;
		height: 256px;
		width: 256px;
	}

	p.essay {
		font-size: 1.4rem;
	}

	div.container {
		max-width: 738px;
		margin-inline: auto;
		display: flex;
		flex-direction: column;
		padding-block-start: 8rem;
		padding-block-end: 4rem;
		padding-inline: 2rem;
		gap: 3rem;
	}

	h1 {
		font-size: 3rem;
	}

	p.subtitle {
		font-size: 1.25rem;
	}
</style>
