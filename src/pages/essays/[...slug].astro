---
// Scaffolding only — replace with the real post layout.
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const essays = await getCollection('essays');
  return essays.map((essay) => ({ params: { slug: essay.id }, props: { essay } }));
}

const { essay } = Astro.props;
const { Content } = await render(essay);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{essay.data.title}</title>
    <meta name="description" content={essay.data.description} />
  </head>
  <body>
    <article>
      <h1>{essay.data.title}</h1>
      <Content />
    </article>
  </body>
</html>
