---
import { Icon } from "astro-icon/components";
import meta from "../meta.json";
---

<nav>
    <ul class="navlist">
        <li>
            <a href="/">
                <Icon name="tabler:home" />
                Home
            </a>
        </li>
        <li>
            <a href="/ai/">
                <Icon name="tabler:robot-off" />
                AI
            </a>
        </li>
        <li>
            <a href="/essays/">
                <Icon name="tabler:pencil-bolt" />
                Essays
            </a>
        </li>
        <li>
            <a href={meta["cv-link"]}>
                <Icon name="tabler:file-cv" />
                CV
            </a>
        </li>
    </ul>
</nav>

<style>
    nav {
        padding-inline: 1.5rem;
        padding-block: 2rem;
    }

    .navlist {
        display: flex;
        gap: 2rem;
        justify-content: center;

        font-size: 1.25rem;

        li > a {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
        }

        li {
            padding: 0.25rem 0.5rem;

            &:hover {
                background-color: #dedede;
                transition: color 2s ease-in-out;
            }
        }
    }
</style>
