---
import { Icon } from "astro-icon/components";
---

<nav class="navbar">
    <ul class="links">
        <li>
            <Icon name="tabler:pencil-bolt" />Essays
            <a href=""></a>
        </li>
        <li>
            <Icon name="tabler:mood-smile" />About
            <a href=""></a>
        </li>
        <li>
            <Icon name="tabler:robot-off" />AI
            <a href=""></a>
        </li>
        <li>
            <Icon name="tabler:file-cv" />CV
            <a href=""></a>
        </li>
    </ul>
    <button class="mail-button"><Icon name="tabler:mail"/></button>
</nav>

<style>
    .navbar {
        position: relative;
        z-index: 1;
        padding-block: 0.25rem;
        margin-block-start: 0.5rem;
        padding-inline: 1.5rem;
        display: flex;
        gap: 0.5rem;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
    }

    .links {
        background-color: #eeeeee;
        border: 1px solid #e0e0e0;
        color: #424242;
        /* fluid: full desktop size on large screens, legible on phones */
        font-size: 1rem;
        padding-block: 0.223em;
        padding-inline: 0.665em;
        border-radius: 10rem;
        display: flex;
        gap: 0.11em;
        max-width: 100%;
    }

    .links li {
        padding-block: 0.445em;
        padding-inline: 0.89em;
        
        display: flex;
        gap: 0.445em;
        align-items: center;

        border-radius: 10rem;
        position: relative;
        white-space: nowrap;

        &:hover {
            background-color: #E0E0E0;
            transition: color 0.2s ease;
        }
       
        a {
            position: absolute;
            inset: 0;
            border-radius: 10rem;
        }
    }

    /* icons are decorative — drop them before the labels have to shrink */
    @media (max-width: 26rem) {
        .links li > svg {
            display: none;
        }
    }

    .mail-button {
        display: inline-flex;
        align-items: center;
        background-color: #FFA000;
        font-size: 1.25rem;
        border-radius: 6rem;
        padding: 0.667em;

         &:hover {
            background-color: #FF6F00;
            transition: color 0.2s ease;
        }

    }

    @media (width > 1024px) {
        .links {
            font-size: 1.25rem;
        }
    }
</style>
