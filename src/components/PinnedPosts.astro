---
import type { Post } from "../types";

const allPosts: Post[] = Object.values(
    import.meta.glob("../pages/essays/*.md", { eager: true }),
);

const pinnedPosts = allPosts.filter((post) => post.frontmatter.pinned);
---

<div class="container">
    <h2>You'll most likely want to read...</h2>

    <ul>
        {
            pinnedPosts.map((post) => (
                <li>
                    <article>
                        <h4>{post.frontmatter.title}</h4>
                        <p>{post.frontmatter.description}</p>
                        <a href={post.url} />
                    </article>
                </li>
            ))
        }
    </ul>
</div>

<style>
    ul {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-top: 2rem;
    }
    article {
        position: relative;
        &:hover {
            text-decoration: underline;
        }

        h4 {
            text-decoration: none;
        }

        a {
            position: absolute;
            width: 100%;
            height: 100%;
            inset: 0;
        }
    }

    .container {
        border: 2px solid;
        padding: 2rem;
        border-radius: 1rem;
    }
</style>
