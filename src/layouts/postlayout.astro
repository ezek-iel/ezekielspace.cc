---
import Base from "./base.astro";
import "../styles/markdown-override.css";
import Footer from "../components/Footer.astro";
import moment from "moment";

const { frontmatter } = Astro.props;
---

<Base
    description={frontmatter.description ||
        "Ezekiel is a software developer who lives in Lagos. He loves understanding how things works. You will most likely see him nerding out on documentaries, books or playing hard games"}
    title={frontmatter.title}
    url={(frontmatter.url as string).replace("/essays", "posts")}
    ogImage={`/og${(frontmatter.url as string).replace("/essays", "")}.png`}
>
    <div class="markdown-container">
        <div class="title">
            <h1>{frontmatter.title}</h1>
            <p class="info">
                Written on <span class="date"
                    >{moment(frontmatter.date).format("Do MMMM YYYY")}
                </span> by {frontmatter.author}
            </p>
            <ul class="tags">
                {frontmatter.tags.map((tag: string) => <li># {tag}</li>)}
            </ul>
        </div>

        <slot />
        <div class="footer-container">
            <Footer postName={frontmatter.url} />
        </div>
    </div>
</Base>

<style>
    .footer-container {
        margin-block-start: 2rem;
    }

    .title {
        margin-bottom: 3rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    span.date {
        font-weight: bold;
    }

    .info {
        font-size: 1.15rem;
    }

    .tags {
        list-style: none;
        flex-wrap: wrap;
        display: inline;
        margin-top: 1rem;
    }

    .tags li {
        display: inline;
        background-color: crimson;
        padding-block: 0.5rem;
        padding-inline: 1rem;
        border-radius: 1rem;
        font-size: 0.9rem;
        color: white;

        &:not(:last-child) {
            margin-right: 0.5rem;
        }
    }
</style>
