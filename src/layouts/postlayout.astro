---
import Base from "./base.astro";
import "../styles/markdown-override.css";
import Footer from "../components/Footer.astro";
import moment from "moment";


const { frontmatter } = Astro.props;
---

<Base>
    <div class="markdown-container">
        <div class="title">
            <h1>{frontmatter.title}</h1>
            <p class="info">Written on <span class="date">{moment(frontmatter.date).format("MMM Do YYYY")}
                </span> by {frontmatter.author}</p>
        </div>

        <slot />
        <div class="footer-container">
            <Footer/>
        </div>
    </div>
</Base>

<style>
    .footer-container {
        margin-block-start: 2rem;
    }

    .title {
        margin-bottom: 3rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }
    
    span.date {
        font-weight: bold;
    }

    .info {
        font-size: 1.15rem;
    }
</style>
